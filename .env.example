# Supabase (future integration)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin login (server-side only; never NEXT_PUBLIC_). Set the same value in Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=
# Optional extra signing secret for admin sessions (any long random string).
ADMIN_SESSION_SECRET=
# Neon Postgres connection used by the site and admin
DATABASE_URL=
# Vercel Blob token for admin image uploads
BLOB_READ_WRITE_TOKEN=
