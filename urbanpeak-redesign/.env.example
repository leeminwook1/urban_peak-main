# Optional email delivery. All three are required. No secret belongs in NEXT_PUBLIC_*.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=urbanpeak2020@gmail.com
# Use an absolute durable/private directory in production. Default: .private/inquiries
CONTACT_STORAGE_DIR=
NEXT_PUBLIC_SITE_URL=https://urbanpeak.co.kr

# Admin (/admin). Without ADMIN_PASSWORD the admin login stays disabled.
ADMIN_PASSWORD=
# Optional extra signing secret for admin sessions (any long random string).
ADMIN_SESSION_SECRET=
# Content storage for the admin. Use a NEW Neon database or branch, not the live site's tables.
# Without it, edits are saved to .private/content (local development only).
DATABASE_URL=
# Image uploads from the admin (Vercel Blob). Without it, uploads go to public/uploads (local only).
BLOB_READ_WRITE_TOKEN=
